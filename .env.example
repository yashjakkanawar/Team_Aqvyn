# Copy this file to ".env" (same folder) and fill it in. ".env" is git-ignored, so the key never gets committed.
# Any OpenAI-compatible /v1/chat/completions endpoint works (your local gateway, Gemini via a proxy, etc.).
AGENTX_LLM_BASE_URL=http://localhost:8081/v1
AGENTX_LLM_API_KEY=put-your-key-here
AGENTX_LLM_MODEL=gemini-3.7-flash
AGENTX_LLM_TIMEOUT=60
